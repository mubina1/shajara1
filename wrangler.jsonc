{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shajara1",
  "main": "src/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  // Baza birinchi deployda avtomatik yaratiladi (wrangler >= 4.45).
  "d1_databases": [{ "binding": "DB", "database_name": "shajara-db","database_id": "af3eaf75-1e8e-43e6-a4c9-2d6d40df0c84" }],
  "observability": { "enabled": true }
}
